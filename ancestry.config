# DeepECG-Ancestry pipeline configuration -- same flat `key: value` format as heartwise.config,
# read by run_ancestry.bash with the same get_param().
#
# Paths are the ones dockerfile.ancestry mounts. Everything here can also be given on the
# command line, which wins.

mode: all
device: auto
batch_size: 64
threads: 16
jobs: 8

# --- where the run lives -------------------------------------------------------------------
work_folder: /app/work
results_folder: /app/results
run_name: EXTERNAL-SITE

# --- the site's three inputs ---------------------------------------------------------------
# rfmix:      RFMix weighted-sum ancestry proportions, one or more files (space-separated)
# ecg_meta:   the ECG inventory (parquet, csv or tsv): ecg id, sex, age, path to the waveform
# geno:       plink2 pgen/bed stem or VCF, with @ standing for the chromosome number
rfmix: /app/inputs/rfmix.txt
ecg_meta: /app/inputs/ecg_meta.parquet
geno: /app/inputs/geno/chr@
build: grch38

# --- optional inputs; leave empty to skip the arm that needs them --------------------------
# labels:       the site's own 77-finding ground truth, for the fairness audit
# statements:   free-text ECG statements instead, classified by the BERT model
# measurements: the site's cart measurement panel; without it `traits` measures with NeuroKit2
# ses:          area-level deprivation per patient (e.g. the Social Deprivation Index)
labels:
statements:
measurements:
ses:

# --- where the model comes from ------------------------------------------------------------
# Leave both empty to use the pinned entry in ancestry/model_manifest.json. Set them when the ancestry
# snapshot lives somewhere else -- a different organisation, or a re-upload. The revision must
# be the exact 40-character commit: a branch name would make the run unreproducible, and is
# refused. `python -m ancestry weights` prints what is currently resolved and from where.
ancestry_model_repo:
ancestry_model_revision:

# auto         a path on the command line, then the env var, then a fetched snapshot, then the pin
# local        never reach the network: an air-gapped site, with the weights mounted
# huggingface  ignore the mounts and use the pinned revision, to be sure what ran
weights_source: auto

# --- optional arms -------------------------------------------------------------------------
with_scan: false
save_embeddings: false
hugging_face_api_key_path: /app/api_key.json
